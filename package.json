{
  "name": "ege-flashcards",
  "version": "1.0.0",
  "description": "Интерактивные карточки для подготовки к ЕГЭ с алгоритмом SM-2 / Interactive flashcards for Russian EGE exam preparation",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx live-server --port=3000",
    "build:css": "sass css/src/main.scss css/style.css --no-source-map",
    "watch:css": "sass css/src/main.scss css/style.css --no-source-map --watch"
  },
  "keywords": [
    "ege",
    "flashcards",
    "education",
    "russian",
    "spaced-repetition",
    "sm2",
    "trigonometry",
    "math",
    "computer-science"
  ],
  "author": "ave",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ave/ege-flashcards.git"
  },
  "homepage": "https://ave.github.io/ege-flashcards",
  "bugs": {
    "url": "https://github.com/ave/ege-flashcards/issues"
  },
  "devDependencies": {
    "sass": "^1.97.3"
  }
}
